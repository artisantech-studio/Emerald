# ═══════════════════════════════════════════════════════════════════════
# Artisan Trust-Link Gateway — Production Environment Template
# ═══════════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.prod.template .env.prod
#   2. Generate secrets using the commands below each variable.
#   3. NEVER commit .env.prod to version control.
# ═══════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=masterbuilder
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
POSTGRES_DB=artisan_trust

# ─── Application Database URL ────────────────────────────────────────
# Must match the Postgres credentials above. Use the Docker service name
# 'ledger_db' as the hostname (not localhost).
DATABASE_URL=postgresql://masterbuilder:REPLACE_WITH_GENERATED_PASSWORD@ledger_db:5432/artisan_trust

# ─── Merkle Ledger Cryptographic Salt ────────────────────────────────
# CRITICAL: Must be at least 64 hex characters (32 bytes of entropy).
# Generate: openssl rand -hex 32
LEDGER_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# ─── WhatsApp Cloud API ──────────────────────────────────────────────
# Verify token for webhook registration handshake (can be any strong string)
# Generate: openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_VERIFY_TOKEN

# Meta App Secret (from Meta Developer Dashboard → App Settings → Basic)
# Used to validate X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET

# WhatsApp API Bearer Token (from Meta Developer Dashboard)
WHATSAPP_API_TOKEN=REPLACE_WITH_API_TOKEN
